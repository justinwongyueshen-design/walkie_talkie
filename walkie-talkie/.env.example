# ---------------------------------------------------------------
# Walkie Talkie configuration. Copy this file to ".env" and edit.
# ---------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false

# URL folder of the app, e.g. /walkie-talkie when it lives in C:\xampp\htdocs\walkie-talkie.
# Leave empty to detect it automatically.
APP_BASE_PATH=/walkie-talkie

# Public address used for the QR code (optional). Example: https://radio.example.com
# For phone testing on your LAN use your PC's IP, e.g. http://192.168.1.20/walkie-talkie
APP_PUBLIC_URL=

# Secret used to sign session tokens (HMAC-SHA256). Use a long random value, e.g.
#   php -r "echo bin2hex(random_bytes(32));"
# If left empty (or CHANGE_THIS_SECRET) the app creates one in storage/.secret.
SIGNAL_SECRET=CHANGE_THIS_SECRET

# Maximum users per channel
SIGNAL_MAX_PEERS=8

# Maximum talk time per press, in milliseconds (30000 = 30 seconds)
SIGNAL_FLOOR_TIMEOUT_MS=30000

# Largest accepted /signal request body and WebRTC data field, in bytes
SIGNAL_MAX_BODY=32768
SIGNAL_MAX_DATA=12288

# Token lifetime (seconds), peer inactivity timeout and polling interval (ms)
SIGNAL_TOKEN_TTL=3600
SIGNAL_PEER_TIMEOUT_MS=20000
SIGNAL_POLL_INTERVAL_MS=800

# Requests allowed per peer per minute on /signal
RATE_LIMIT_PER_MINUTE=600

# WebRTC ICE servers (comma separated STUN list). Add a TURN server for restrictive networks.
ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
ICE_TURN_URL=
ICE_TURN_USERNAME=
ICE_TURN_CREDENTIAL=
